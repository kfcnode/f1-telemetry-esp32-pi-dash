# Copy to .env and fill in. .env is git-ignored. car_sender.py reads it.

# ThingSpeak channel the driver node writes to (Channels > your channel > API Keys)
THINGSPEAK_CHANNEL_ID=0000000
THINGSPEAK_READ_KEY=XXXXXXXXXXXXXXXX

# Laptop running server_and_ui.py, as seen from the Raspberry Pi
DASH_SERVER_URL=http://192.168.1.10:8050

# Driver node on the same Wi-Fi (for --vitals local)
ESP32_URL=http://f1-driver.local

DRIVER_NAME=DRIVER
